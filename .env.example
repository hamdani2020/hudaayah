# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# ── Django ──────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-dev-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web,10.0.2.2

# ── PostgreSQL (Compose `db` service) ───────────────────────────────
POSTGRES_DB=hudaayah
POSTGRES_USER=hudaayah
POSTGRES_PASSWORD=hudaayah
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Quran Foundation (backend-only; pre-live for MVP) ───────────────
QF_ENV=prelive
QF_CLIENT_ID=
QF_CLIENT_SECRET=
QF_CACHE_MAX_SECONDS=604800

# ── Social auth (server verifies ID tokens; these are the expected `aud`) ──
# Comma-separated OAuth client IDs (web/iOS/Android may each have one).
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# ── Google Cloud / Stitch (design tooling only) ─────────────────────
GOOGLE_CLOUD_PROJECT=hudaayah
STITCH_PROJECT_ID=hudaayah
STITCH_ACCESS_TOKEN=
