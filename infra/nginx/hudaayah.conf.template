# Nginx reverse proxy for the Hudaayah backend.
#
# Rendered by docker-entrypoint.sh (envsubst on ${SERVER_NAME}) into
# /etc/nginx/conf.d/hudaayah.conf at container start. Terminates TLS and proxies to the
# gunicorn `web` service on the internal compose network. The ACME HTTP-01 challenge is
# served from /var/www/certbot so Let's Encrypt can issue/renew without stopping nginx.

upstream hudaayah_web {
    server web:8000;
}

# ── Port 80: ACME challenge + redirect everything else to HTTPS ──────────────────
server {
    listen 80;
    listen [::]:80;
    server_name ${SERVER_NAME};

    # Let's Encrypt HTTP-01 challenge files (written by the certbot container).
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── Port 443: TLS termination + reverse proxy ────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/letsencrypt/live/${SERVER_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SERVER_NAME}/privkey.pem;

    # Modern TLS only (satisfies the "TLS 1.2+" steering rule).
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size 10m;

    # Static files are collected into this shared volume at image build / deploy time;
    # nginx serves them directly so gunicorn isn't in the static path.
    location /static/ {
        alias /app/staticfiles/;
        access_log off;
        expires 30d;
        add_header Cache-Control "public";
    }

    location / {
        proxy_pass http://hudaayah_web;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        # Django (production.py) trusts this to detect the original HTTPS request.
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }
}
