#!/usr/bin/env bash
# Hudaayah backend bootstrap (minimal). Installs Docker + Compose + the SSM agent,
# writes per-instance config to /opt/hudaayah/deploy.env, clones the repo, and hands
# off to the VERSION-CONTROLLED deploy script (infra/deploy/deploy.sh).
#
# The compose file and deploy logic now live in the repo, so edits to them ship via a
# normal deploy (git reset --hard in deploy.sh) WITHOUT recreating the instance. This
# bootstrap only runs on first boot / instance replacement.
set -euxo pipefail

AWS_REGION="${aws_region}"
GIT_REPO_URL="${git_repo_url}"
GIT_BRANCH="${git_branch}"
SSM_PREFIX="${ssm_parameter_prefix}"
SERVER_NAME="${server_name}"
LETSENCRYPT_EMAIL="${letsencrypt_email}"
APP_DIR="/opt/hudaayah/app"

# --- Base packages (Amazon Linux 2023) -----------------------------------------
dnf update -y
dnf install -y docker amazon-ssm-agent git jq

systemctl enable --now docker
systemctl enable --now amazon-ssm-agent

# Docker Compose v2 plugin.
mkdir -p /usr/libexec/docker/cli-plugins
COMPOSE_VERSION="v2.29.7"
curl -SL "https://github.com/docker/compose/releases/download/$${COMPOSE_VERSION}/docker-compose-linux-x86_64" \
  -o /usr/libexec/docker/cli-plugins/docker-compose
chmod +x /usr/libexec/docker/cli-plugins/docker-compose

mkdir -p /opt/hudaayah

# --- Per-instance config for the deploy script ----------------------------------
# These are the only values Terraform injects; everything else (compose file, deploy
# logic, seed) is version-controlled in the repo. Non-secret — secrets come from SSM.
cat > /opt/hudaayah/deploy.env <<ENV
AWS_REGION="$${AWS_REGION}"
GIT_REPO_URL="$${GIT_REPO_URL}"
GIT_BRANCH="$${GIT_BRANCH}"
SSM_PREFIX="$${SSM_PREFIX}"
SERVER_NAME="$${SERVER_NAME}"
LETSENCRYPT_EMAIL="$${LETSENCRYPT_EMAIL}"
APP_DIR="$${APP_DIR}"
APP_ENV_FILE="/opt/hudaayah/app.env"
ENV
chmod 600 /opt/hudaayah/deploy.env

# --- Clone the repo so the committed deploy script is available -----------------
if [ ! -d "$${APP_DIR}/.git" ]; then
  git clone --branch "$${GIT_BRANCH}" "$${GIT_REPO_URL}" "$${APP_DIR}"
fi

# Symlink the version-controlled deploy script to the stable path SSM invokes.
ln -sf "$${APP_DIR}/infra/deploy/deploy.sh" /opt/hudaayah/deploy.sh
chmod +x "$${APP_DIR}/infra/deploy/deploy.sh" || true

# --- First rollout --------------------------------------------------------------
/opt/hudaayah/deploy.sh "$${GIT_BRANCH}" \
  || echo "Initial deploy failed — check /var/log/cloud-init-output.log and rerun via SSM."
