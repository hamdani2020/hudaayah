#!/usr/bin/env bash
# Hudaayah backend bootstrap — installs Docker + Compose + the SSM agent, clones the
# repo, and does a first `docker compose up --build`. Subsequent deploys are driven by
# GitHub Actions via SSM, which re-runs /opt/hudaayah/deploy.sh (git pull + compose up).
set -euxo pipefail

AWS_REGION="${aws_region}"
APP_PORT="${app_port}"
GIT_REPO_URL="${git_repo_url}"
GIT_BRANCH="${git_branch}"
SSM_PREFIX="${ssm_parameter_prefix}"
SERVER_NAME="${server_name}"
LETSENCRYPT_EMAIL="${letsencrypt_email}"
APP_DIR="/opt/hudaayah/app"

# --- Base packages (Amazon Linux 2023) -----------------------------------------
dnf update -y
dnf install -y docker amazon-ssm-agent git jq

systemctl enable --now docker
systemctl enable --now amazon-ssm-agent

# Docker Compose v2 plugin.
mkdir -p /usr/libexec/docker/cli-plugins
COMPOSE_VERSION="v2.29.7"
curl -SL "https://github.com/docker/compose/releases/download/$${COMPOSE_VERSION}/docker-compose-linux-x86_64" \
  -o /usr/libexec/docker/cli-plugins/docker-compose
chmod +x /usr/libexec/docker/cli-plugins/docker-compose

mkdir -p /opt/hudaayah

# --- Production compose file ----------------------------------------------------
# Runs nginx (TLS) + Django (gunicorn) + Postgres on the instance. nginx terminates
# HTTPS for the configured server name and proxies to gunicorn on the internal network —
# gunicorn is NOT published to the host. certbot issues/renews the Let's Encrypt cert.
# Secrets come from an env file that deploy.sh rebuilds from SSM on every rollout.
cat > /opt/hudaayah/docker-compose.prod.yml <<COMPOSE
services:
  db:
    image: postgres:16
    restart: unless-stopped
    # env_file injects POSTGRES_DB/USER/PASSWORD into the container; no compose-level
    # variable interpolation here (compose resolves those from its own env, not env_file).
    env_file: /opt/hudaayah/app.env
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -q"]
      interval: 5s
      timeout: 3s
      retries: 10

  web:
    build:
      context: __APP_DIR__/backend
      args:
        REQUIREMENTS: production
    restart: unless-stopped
    command: gunicorn config.wsgi:application --bind 0.0.0.0:8000 --workers 3
    env_file: /opt/hudaayah/app.env
    environment:
      DJANGO_SETTINGS_MODULE: config.settings.production
      POSTGRES_HOST: db
      POSTGRES_PORT: "5432"
    # No host port: only nginx reaches gunicorn, over the internal compose network.
    expose:
      - "8000"
    volumes:
      # Shared with nginx so it can serve /static/ directly. web's entrypoint runs
      # collectstatic into this path on boot.
      - staticfiles:/app/staticfiles
    depends_on:
      db:
        condition: service_healthy

  nginx:
    build:
      context: __APP_DIR__/infra/nginx
    restart: unless-stopped
    environment:
      SERVER_NAME: __SERVER_NAME__
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - staticfiles:/app/staticfiles:ro
      - letsencrypt:/etc/letsencrypt
      - certbot_www:/var/www/certbot
    depends_on:
      - web

  # One-shot/renewal certbot. deploy.sh runs issuance explicitly on first deploy;
  # this service handles periodic renewal (checks twice daily, no-op until due).
  certbot:
    image: certbot/certbot:latest
    restart: unless-stopped
    volumes:
      - letsencrypt:/etc/letsencrypt
      - certbot_www:/var/www/certbot
    entrypoint: /bin/sh -c 'trap exit TERM; while :; do certbot renew --webroot -w /var/www/certbot --quiet; sleep 12h; done'

volumes:
  pgdata:
  staticfiles:
  letsencrypt:
  certbot_www:
COMPOSE
sed -i \
  -e "s|__APP_DIR__|$${APP_DIR}|g" \
  -e "s|__APP_PORT__|$${APP_PORT}|g" \
  -e "s|__SERVER_NAME__|$${SERVER_NAME}|g" \
  /opt/hudaayah/docker-compose.prod.yml

# --- Deploy script (re-invoked by SSM on every deploy) --------------------------
cat > /opt/hudaayah/deploy.sh <<'DEPLOY'
#!/usr/bin/env bash
set -euo pipefail

AWS_REGION="__AWS_REGION__"
GIT_REPO_URL="__GIT_REPO_URL__"
GIT_BRANCH="__GIT_BRANCH__"
SSM_PREFIX="__SSM_PREFIX__"
SERVER_NAME="__SERVER_NAME__"
LETSENCRYPT_EMAIL="__LETSENCRYPT_EMAIL__"
APP_DIR="/opt/hudaayah/app"
COMPOSE_FILE="/opt/hudaayah/docker-compose.prod.yml"
REF="$${1:-$${GIT_BRANCH}}"

# 1) Sync source.
if [ ! -d "$${APP_DIR}/.git" ]; then
  git clone --branch "$${GIT_BRANCH}" "$${GIT_REPO_URL}" "$${APP_DIR}"
fi
git -C "$${APP_DIR}" fetch --all --prune
git -C "$${APP_DIR}" checkout "$${GIT_BRANCH}"
git -C "$${APP_DIR}" reset --hard "origin/$${REF}" 2>/dev/null || git -C "$${APP_DIR}" reset --hard "$${REF}"

# 2) Build the runtime env file from SSM Parameter Store (SecureString params).
ENV_FILE=/opt/hudaayah/app.env
: > "$${ENV_FILE}"
chmod 600 "$${ENV_FILE}"
for param in $(aws ssm get-parameters-by-path \
      --region "$${AWS_REGION}" \
      --path "$${SSM_PREFIX}" \
      --with-decryption \
      --recursive \
      --query 'Parameters[].Name' --output text); do
  key="$${param##*/}"
  value="$(aws ssm get-parameter --region "$${AWS_REGION}" --name "$${param}" --with-decryption --query 'Parameter.Value' --output text)"
  printf '%s=%s\n' "$${key}" "$${value}" >> "$${ENV_FILE}"
done

# 3) Build + start the stack. nginx boots with a temporary self-signed cert if no real
#    one exists yet (see infra/nginx/docker-entrypoint.sh), so it can serve the ACME
#    HTTP-01 challenge on :80.
#    `</dev/null` detaches stdin so the detached containers never inherit (and hold open)
#    the stdio handles of the SSM-invoked command — otherwise the SSM invocation stays
#    InProgress forever even though the deploy finished.
docker compose -f "$${COMPOSE_FILE}" up -d --build </dev/null

# 4) Obtain the Let's Encrypt cert on first deploy (idempotent: --keep-until-expiring
#    is a no-op once a valid cert exists, so this is safe to run every rollout). The
#    certbot container in compose handles ongoing renewal; this handles first issuance.
#    The authoritative check runs inside the certbot container against the shared
#    letsencrypt volume: issue when there is no real cert (or only the self-signed
#    placeholder, which certbot did not register, so no renewal/<name>.conf exists).
if ! docker compose -f "$${COMPOSE_FILE}" run --rm --entrypoint sh certbot -c \
      "test -f /etc/letsencrypt/renewal/$${SERVER_NAME}.conf && openssl x509 -checkend 86400 -noout -in /etc/letsencrypt/live/$${SERVER_NAME}/cert.pem" 2>/dev/null; then
  echo "Requesting/renewing Let's Encrypt certificate for $${SERVER_NAME}..."
  # Remove any temporary self-signed cert so certbot writes into a clean live dir.
  docker compose -f "$${COMPOSE_FILE}" run --rm --entrypoint sh certbot -c \
    "rm -rf /etc/letsencrypt/live/$${SERVER_NAME} /etc/letsencrypt/archive/$${SERVER_NAME} /etc/letsencrypt/renewal/$${SERVER_NAME}.conf" || true
  docker compose -f "$${COMPOSE_FILE}" run --rm certbot certonly \
    --webroot -w /var/www/certbot \
    -d "$${SERVER_NAME}" \
    --email "$${LETSENCRYPT_EMAIL}" \
    --agree-tos --no-eff-email --non-interactive \
    --keep-until-expiring \
    && docker compose -f "$${COMPOSE_FILE}" exec -T nginx nginx -s reload
fi

# 5) Migrations against the running web container. Static files are collected into the
#    shared staticfiles volume by web's entrypoint on boot (nginx serves /static/).
docker compose -f "$${COMPOSE_FILE}" exec -T web python manage.py migrate --noinput

# 6) Prune dangling images.
docker image prune -f
DEPLOY

sed -i \
  -e "s|__AWS_REGION__|$${AWS_REGION}|g" \
  -e "s|__GIT_REPO_URL__|$${GIT_REPO_URL}|g" \
  -e "s|__GIT_BRANCH__|$${GIT_BRANCH}|g" \
  -e "s|__SSM_PREFIX__|$${SSM_PREFIX}|g" \
  -e "s|__SERVER_NAME__|$${SERVER_NAME}|g" \
  -e "s|__LETSENCRYPT_EMAIL__|$${LETSENCRYPT_EMAIL}|g" \
  /opt/hudaayah/deploy.sh
chmod +x /opt/hudaayah/deploy.sh

# First rollout.
/opt/hudaayah/deploy.sh "$${GIT_BRANCH}" || echo "Initial deploy failed — check /var/log/cloud-init-output.log and rerun via SSM."
